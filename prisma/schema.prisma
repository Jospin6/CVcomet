// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                   String          @id @default(uuid())
  email                String          @unique
  name                 String?
  emailVerified        Boolean         @default(false)
  verificationCode     String?
  verificationCodeExpiresAt DateTime?
  verificationCodeSentAt DateTime?
  verificationCodeAttempts Int @default(0)
  image                String?
  phone                String?
  address              String?
  languages            String?
  linkedin             String?
  portfolio            String?
  github               String?
  summary              String?
  password             String?
  skills               String?
  hobbies              String?
  headline             String?
  careerGoal           String?
  experienceLevel      String?
  targetJobTitle       String?
  targetIndustry       String?
  targetCountry        String?
  preferredWorkMode    String?
  resumeSource         String?
  targetMarket         String?
  referralSource       String?
  templateAccent       String?         @default("#173F35")
  coverLetterAccent    String?         @default("#173F35")
  onboardingCompletedAt DateTime?
  profileRevision      Int             @default(0)
  awards               Json?
  professionalLinks    Json?
  jobPreferences       Json?
  portfolioSlug        String?         @unique
  portfolioPublic      Boolean         @default(false)
  isSubscribed         Boolean         @default(false)
  role                 UserRole        @default(USER)
  lastGeneratedAt      DateTime?
  subscriptionId       String?
  generationCount      Int             @default(0)
  currentTemplateId    String?
  currentTemplate      Template?       @relation("UserCurrentTemplate", fields: [currentTemplateId], references: [id])
  currentCoverLetterId String?
  stripeCustomerId     String?
  currentCoverLetter   Template?       @relation("UserCurrentCoverLetter", fields: [currentCoverLetterId], references: [id])
  certifications       Certification[]
  Education            Education[]
  Experience           Experience[]
  Project              Project[]
  Conversation         Conversation[]
  atsAnalyses          AtsAnalysis[]
  jobOpportunities     JobOpportunity[]
  jobMatches           JobMatch[]
  jobApplications      JobApplication[]
  interviewSessions    InterviewSession[]
  aiUsage              AIUsage[]
  careerAgentObservations CareerAgentObservation[]
  aiQuotaWindows       AiQuotaWindow[]
  uploadedResumes      UploadedResume[]
  resignationLetters   ResignationLetter[]
  careerMaps           CareerMap[]
  careerGoals          CareerGoal[]
  careerEvidence       CareerEvidence[]
  resumeAIProposals   ResumeAIProposal[]
  coverLetterAIProposals CoverLetterAIProposal[]
  careerAgentMemories CareerAgentMemory[]
  careerMissions CareerMission[]
  applicationPackets CareerApplicationPacket[]
  jobRecommendationPreference JobRecommendationPreference?
  subscription         Subscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  Account Account[]

  Session Session[]
}

model CareerMap {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvId        String?
  title       String
  preferences Json
  profile     Json
  graph       Json
  careerGoals CareerGoal[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId, updatedAt])
}

model CareerGoal {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerMapId String?
  careerMap   CareerMap? @relation(fields: [careerMapId], references: [id], onDelete: SetNull)
  roleId      String
  title       String
  plan        Json
  completedStepIds String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId, updatedAt])
  @@unique([userId, roleId])
}

enum UserRole {
  USER
  ADMIN
}

model Account {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Champs communs
  type       String?
  providerId String
  accountId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Pour credentials
  password String?

  // Pour OAuth
  providerAccountId String?
  refresh_token     String?
  access_token      String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([providerId, accountId])
}

model Session {
  id           String   @id @default(uuid())
  token        String?   @unique @map("sessionToken")
  userId       String
  expires      DateTime?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ipAddress    String?
  userAgent    String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String?
  value      String?
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Conversation {
  id        String   @id @default(uuid())
  title     String?
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  CoverLetter CoverLetter[]
  Cv          Cv[]
  Message     Message[]
}

model Experience {
  id          String  @id @default(uuid())
  title       String
  company     String
  location    String
  start       String
  end         String?
  description String?
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Education {
  id          String  @id @default(uuid())
  degree      String
  school      String
  start       String
  end         String?
  description String?
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Certification {
  id           String  @id @default(uuid())
  name         String
  organization String
  date         String
  description  String?
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String  @id @default(uuid())
  start       String?
  end         String?
  title       String
  url         String?
  description String?
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Cv {
  id             String   @id @default(uuid())
  title          String
  summary        String[]
  skills         Json?
  experiences    Json?
  educations     Json?
  certifications Json?
  projects       Json?
  languages      Json?
  contact        Json?
  design         Json?
  revision       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  templateId     String?
  template       Template?    @relation(fields: [templateId], references: [id])
  versions       ResumeVersion[]
  aiProposals    ResumeAIProposal[]
  atsAnalyses    AtsAnalysis[]
  jobMatches     JobMatch[]
  tailoredMatches JobMatch[] @relation("TailoredResume")
  applications  JobApplication[]
  applicationPackets CareerApplicationPacket[]
  coverLetters  CoverLetter[]
}

model UploadedResume {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  mimeType    String
  size        Int
  content     Bytes
  previewText String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}


/** Independently owned, editable resignation letters. No AI-generated claims. */
model ResignationLetter {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String   @default("Resignation letter")
  recipient   String   @default("")
  company     String   @default("")
  subject     String   @default("Resignation")
  body        String   @default("")
  signature   String   @default("")
  letterDate  DateTime @default(now())
  revision    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, updatedAt])
}

model CoverLetter {
  id             String  @id @default(uuid())
  recipientName  String
  recipientTitle String
  companyName    String?
  companyAddress String?
  positionTitle  String?

  introduction String
  body         String
  conclusion   String?

  senderName    String?
  senderAddress String?
  senderEmail   String?
  senderPhone   String?
  sendertitle   String?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  templateId     String?
  template       Template?    @relation(fields: [templateId], references: [id])
  jobId          String?
  job            JobOpportunity? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  cvId           String?
  cv             Cv?             @relation(fields: [cvId], references: [id], onDelete: SetNull)
  design         Json?
  revision       Int             @default(0)
  applications   JobApplication[]
  applicationPackets CareerApplicationPacket[]
  aiProposals    CoverLetterAIProposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cvId, createdAt])
}

model Template {
  id           String       @id @default(uuid())
  name         String
  plan         Plan         @default(FREE)
  type         TemplateType // 'CV' ou 'COVER_LETTER'
  templateFile Bytes? // chemin du fichier HTML ou PDF ou JSON
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  markets      String[]     @default([])
  styleFamily  String       @default("MODERN")
  customizable Boolean      @default(true)
  accentColors String[]     @default(["#173F35", "#1E4B8F", "#6B4F3A", "#111827"])

  usersUsingAsTemplate    User[]        @relation("UserCurrentTemplate")
  usersUsingAsCoverLetter User[]        @relation("UserCurrentCoverLetter")
  CVs                     Cv[]
  CoverLetters            CoverLetter[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // 'user' | 'assistant'
  content        String
  createdAt      DateTime     @default(now())
}

enum TemplateType {
  CV
  COVER_LETTER
}

enum Plan {
  FREE
  PAID
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW
  TECHNICAL_INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum InterviewType {
  HR
  BEHAVIORAL
  TECHNICAL
  LEADERSHIP
}

enum SubscriptionPlan {
  FREE
  PRO
  CAREER_PRO
}

enum SubscriptionStatus {
  INACTIVE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model ResumeVersion {
  id        String   @id @default(uuid())
  cvId      String
  cv        Cv       @relation(fields: [cvId], references: [id], onDelete: Cascade)
  label     String?
  snapshot  Json
  createdAt DateTime @default(now())
  @@index([cvId, createdAt])
}

model AtsAnalysis {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvId            String?
  cv              Cv?      @relation(fields: [cvId], references: [id], onDelete: SetNull)
  overallScore    Int
  structureScore  Int
  formattingScore Int
  readabilityScore Int
  contactScore    Int
  experienceScore Int
  skillsScore     Int
  keywordScore    Int
  impactScore     Int
  grammarScore    Int
  strengths       Json
  issues          Json
  createdAt       DateTime @default(now())
  @@index([userId, createdAt])
  @@index([cvId])
}

model JobOpportunity {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  company         String?
  location        String?
  seniority       String?
  description     String
  responsibilities Json?
  requiredSkills  Json?
  preferredSkills Json?
  technologies    Json?
  education       Json?
  experience      Json?
  keywords        Json?
  sourceUrl       String?
  sourceType      String   @default("URL")
  sourceName      String?
  originalText    String?
  analysis        Json?
  documentDrafts  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  matches         JobMatch[]
  applications    JobApplication[]
  applicationPackets CareerApplicationPacket[]
  coverLetters    CoverLetter[]
  @@index([userId, createdAt])
}

model JobMatch {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId           String
  job             JobOpportunity @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cvId            String?
  cv              Cv?      @relation(fields: [cvId], references: [id], onDelete: SetNull)
  overallScore    Int?
  skillScore      Int?
  keywordScore    Int?
  experienceScore Int?
  educationScore  Int?
  fingerprint     String?  @unique
  result          Json?
  tailoring       Json?
  tailoredCvId    String?
  tailoredCv      Cv? @relation("TailoredResume", fields: [tailoredCvId], references: [id], onDelete: SetNull)
  matchedSkills   Json
  missingSkills   Json
  unverifiedSkills Json
  recommendations Json
  createdAt       DateTime @default(now())
  @@index([userId, createdAt])
  @@index([jobId])
}

model JobApplication {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId         String?
  job           JobOpportunity? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  cvId          String?
  cv            Cv?      @relation(fields: [cvId], references: [id], onDelete: SetNull)
  coverLetterId String?
  coverLetter   CoverLetter? @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)
  company       String
  jobTitle      String
  location      String?
  country       String?
  workMode      String?
  contractType  String?
  salary        String?
  currency      String?
  jobUrl        String?
  source        String?
  status        ApplicationStatus @default(SAVED)
  appliedAt     DateTime?
  deadline      DateTime?
  notes         String?
  contactPerson String?
  nextAction    String?
  interviewAt   DateTime?
  archivedAt    DateTime?
  cvSnapshot    Json?
  coverLetterSnapshot Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  interviews    InterviewSession[]
  statusEvents  ApplicationStatusEvent[]
  reminders     ApplicationReminder[]
  @@index([userId, status])
  @@index([userId, createdAt])
}

model ApplicationStatusEvent {
  id            String   @id @default(uuid())
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        ApplicationStatus
  note          String?
  createdAt     DateTime @default(now())
  @@index([applicationId, createdAt])
}

model ApplicationReminder {
  id            String   @id @default(uuid())
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  dueAt         DateTime
  note          String?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  @@index([applicationId, dueAt])
}

model InterviewSession {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  type          InterviewType
  title         String
  overallScore  Int?
  summary       String?
  scheduledAt   DateTime?
  timezone      String?
  format        String?
  contactPerson String?
  preparationNotes String?
  outcome       String?
  status        String   @default("ACTIVE")
  configuration Json?
  report        Json?
  currentQuestion Int    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  messages      InterviewMessage[]
  @@index([userId, createdAt])
}

model InterviewMessage {
  id        String   @id @default(uuid())
  sessionId String
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  feedback  Json?
  score     Int?
  createdAt DateTime @default(now())
  @@index([sessionId, createdAt])
}

// Atomic reservation counters shared by all app instances (not provider billing amounts).
model AiQuotaWindow {
  key         String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period      String
  windowStart DateTime
  requests    Int      @default(0)
  credits     Int      @default(0)
  @@index([userId, period, windowStart])
}

model AIUsage {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature       String
  model         String?
  provider      String?
  inputTokens   Int?
  outputTokens  Int?
  estimatedCost Decimal? @db.Decimal(12, 6)
  createdAt     DateTime @default(now())
  @@index([userId, feature, createdAt])
  @@index([createdAt])
}

enum CareerAgentOutcome {
  COMPLETED
  FAILED
}

enum CareerAgentPhase {
  PLAN
  TOOLS
  ANSWER
}

enum CareerAgentFeedback {
  HELPFUL
  NOT_HELPFUL
}

// Minimal telemetry only. No prompts, CV contents, response text, tool payloads, IPs or emails.
model CareerAgentObservation {
  id         String             @id @default(uuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  outcome    CareerAgentOutcome
  phase      CareerAgentPhase
  durationMs Int
  toolCount  Int                @default(0)
  errorCode  String?            @db.VarChar(60)
  // Historical rows are UNKNOWN; never backfill them as GRAPH without evidence.
  engine     String             @default("UNKNOWN") @db.VarChar(12)
  createdAt  DateTime           @default(now())
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([engine, createdAt, outcome])
}

enum AIProvider {
  OPENAI
  GOOGLE
  ANTHROPIC
  HUGGINGFACE
  GROQ
}

model AISettings {
  id             String     @id @default("global")
  activeProvider AIProvider @default(GOOGLE)
  updatedBy      String?
  updatedAt      DateTime   @updatedAt
}

model AIProviderConfig {
  provider          AIProvider @id
  model             String
  encryptedApiKey   String?
  useEnvironmentKey Boolean    @default(true)
  enabled           Boolean    @default(true)
  updatedBy         String?
  updatedAt         DateTime   @updatedAt
}

model JobBoard {
  id             String   @id @default(uuid())
  provider       String
  region         String   @default("GLOBAL")
  slug           String
  companyName    String?
  careerUrl      String
  discoverySource String
  status         String   @default("PENDING")
  activeJobs     Int      @default(0)
  failureCount   Int      @default(0)
  lastError      String?
  discoveredAt   DateTime @default(now())
  verifiedAt     DateTime?
  lastSyncedAt   DateTime?
  nextCheckAt    DateTime @default(now())
  jobs           ExternalJob[]
  @@unique([provider, region, slug])
  @@index([status, nextCheckAt])
}

model ExternalJob {
  id          String   @id @default(uuid())
  boardId     String
  board       JobBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  provider    String
  externalId  String
  title       String
  company     String
  description String
  location    String?
  contractType String?
  sourceUrl   String
  applyUrl    String
  publishedAt DateTime?
  active      Boolean  @default(true)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  @@unique([provider, externalId])
  @@index([active, lastSeenAt])
  @@index([boardId, active])
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan @default(FREE)
  status               SubscriptionStatus @default(INACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?  @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  lastStripeEventCreated Int     @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Persisted idempotency record: each verified Stripe event is applied at most once.
model BillingWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
  @@index([processedAt])
}

// Shared credential abuse counters across instances (no raw email/IP stored).
model AuthThrottleWindow {
  key       String   @id
  attempts  Int      @default(0)
  resetsAt  DateTime
  @@index([resetsAt])
}

// Career Identity & Evidence Vault (phase 02). Confirmation is a USER
// attestation, NOT an external/background identity verification.
enum CareerEvidenceKind {
  SKILL
  EXPERIENCE
  EDUCATION
  PROJECT
  CERTIFICATION
  ACHIEVEMENT
  LANGUAGE
  OTHER
}

enum CareerEvidenceStatus {
  DRAFT
  CONFIRMED
  REJECTED
  REVOKED
}

enum CareerEvidenceSource {
  MANUAL
  PROFILE_IMPORT
  AI_SUGGESTION
}

model CareerEvidence {
  id              String               @id @default(uuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            CareerEvidenceKind
  statement       String               @db.VarChar(1600)
  source          CareerEvidenceSource @default(MANUAL)
  sourceLabel     String?              @db.VarChar(200)
  sourceKey       String?              @db.VarChar(180)
  status          CareerEvidenceStatus @default(DRAFT)
  revision        Int                  @default(0)
  confirmedAt     DateTime?
  revokedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([userId, sourceKey])
  @@index([userId, status, id])
  @@index([userId, kind, id])
}

// Phase 03 — proposed AI edits are separately reviewed, never persisted directly to a CV.
enum ResumeAIProposalStatus {
  PENDING
  APPLIED
  DISCARDED
}

model ResumeAIProposal {
  id                String                 @id @default(uuid())
  userId            String
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvId              String
  cv                Cv                     @relation(fields: [cvId], references: [id], onDelete: Cascade)
  baseRevision      Int
  status            ResumeAIProposalStatus @default(PENDING)
  edits             Json
  message           String                 @db.VarChar(1000)
  summary           Json
  evidenceRevisions Json                   @default("[]")
  expiresAt         DateTime
  createdAt         DateTime               @default(now())
  decidedAt         DateTime?

  @@index([userId, cvId, status])
  @@index([expiresAt])
}

// Phase 04 — LLM output is an immutable reviewable cover letter draft, never a direct edit.
enum CoverLetterAIProposalStatus {
  PENDING
  APPLIED
  DISCARDED
}

model CoverLetterAIProposal {
  id                String                     @id @default(uuid())
  userId            String
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  letterId          String
  letter            CoverLetter                @relation(fields: [letterId], references: [id], onDelete: Cascade)
  baseRevision      Int
  status            CoverLetterAIProposalStatus @default(PENDING)
  document          Json
  message           String                     @db.VarChar(1000)
  changes           Json
  evidenceRevisions Json                       @default("[]")
  expiresAt         DateTime
  createdAt         DateTime                   @default(now())
  decidedAt         DateTime?

  @@index([userId, letterId, status])
  @@index([expiresAt])
}

// Phase 07: a mission is an OPT-IN private conversation, not a global AI memory.
// Only an active mission can start an agent run; the temporary lease limits races.
enum CareerMissionStatus {
  ACTIVE
  ARCHIVED
}

enum CareerMissionRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum CareerMissionApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CONSUMED
}

enum CareerMissionApprovalAction {
  DRAFT_RESUME_CHANGES
  DRAFT_COVER_LETTER
  SUBMIT_APPLICATION
  SEND_APPLICATION_EMAIL
}

model CareerMission {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String              @db.VarChar(120)
  status      CareerMissionStatus @default(ACTIVE)
  revision    Int                 @default(0)
  activeRunId String?             @db.Uuid
  runs        CareerMissionRun[]
  progressEvents CareerMissionProgressEvent[]
  approvals   CareerMissionApproval[]
  applicationPackets CareerApplicationPacket[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  @@index([userId, updatedAt, id])
}

model CareerMissionRun {
  id          String                 @id @default(uuid())
  missionId   String
  mission     CareerMission          @relation(fields: [missionId], references: [id], onDelete: Cascade)
  userId      String
  requestKey  String                 @db.Uuid
  question    String                 @db.VarChar(6000)
  attachmentsMeta Json?                // Sanitized file names/types only, never document content
  inputDigest String?                 @db.VarChar(64) // Idempotency includes attachment hashes
  specialist String?                  @db.VarChar(32) // Agent selected by server
  answer      String?                @db.VarChar(10000)
  steps       Json?
  progressEvents CareerMissionProgressEvent[]
  status      CareerMissionRunStatus @default(RUNNING)
  attempt     Int                    @default(1)
  leaseToken  String                 @db.Uuid
  leaseUntil  DateTime
  errorCode   String?                @db.VarChar(60)
  feedbackRating CareerAgentFeedback?
  feedbackAt  DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  @@unique([missionId, requestKey])
  @@index([missionId, createdAt, id])
  @@index([userId, status])
  @@index([feedbackAt])
  @@index([createdAt, status])
}

// Bounded technical progress. Only safe step identifiers/codes; never prompts, documents or tool payloads.
model CareerMissionProgressEvent {
  id         BigInt @id @default(autoincrement())
  userId     String
  missionId  String
  mission    CareerMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  runId      String
  run        CareerMissionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  attempt    Int
  kind       String @db.VarChar(40)
  step       String? @db.VarChar(80)
  code       String? @db.VarChar(60)
  createdAt  DateTime @default(now())
  @@index([userId, missionId, runId, id])
  @@index([runId, attempt, id])
  @@index([createdAt, kind])
}

// Approvals bind one exact proposed action digest to its owner and mission.
// Recording APPROVED never executes that action; consumption must be atomic.
model CareerMissionApproval {
  id          String                      @id @default(uuid())
  missionId   String
  mission     CareerMission               @relation(fields: [missionId], references: [id], onDelete: Cascade)
  userId      String
  action      CareerMissionApprovalAction
  payloadHash String                      @db.VarChar(64)
  summary     String                      @db.VarChar(240)
  status      CareerMissionApprovalStatus @default(PENDING)
  expiresAt   DateTime
  decidedAt   DateTime?
  consumedAt  DateTime?
  createdAt   DateTime                    @default(now())
  @@index([missionId, status, expiresAt])
  @@index([userId, createdAt])
}

// Phase 09: user-reviewed application packets. READY is NOT externally submitted.
enum CareerApplicationPacketStatus {
  DRAFT
  READY
  CANCELED
}

model CareerApplicationPacket {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestKey     String   @db.Uuid
  intentHash     String   @db.VarChar(64)
  missionId      String?
  mission        CareerMission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  jobId          String
  job            JobOpportunity @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cvId           String
  cv             Cv @relation(fields: [cvId], references: [id], onDelete: Cascade)
  coverLetterId  String?
  coverLetter    CoverLetter? @relation(fields: [coverLetterId], references: [id], onDelete: Cascade)
  cvRevision     Int
  letterRevision Int?
  jobUpdatedAt   DateTime
  subject        String   @db.VarChar(300)
  body           String   @db.VarChar(12000)
  recipientEmail String?  @db.VarChar(254)
  language       String   @db.VarChar(2)
  status         CareerApplicationPacketStatus @default(DRAFT)
  revision       Int      @default(0)
  approvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([userId, requestKey])
  @@index([userId, updatedAt, id])
  @@index([missionId, createdAt])
}


/// Per-account CV-based recommendations, independent of career-map settings.
model JobRecommendationPreference {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filters    Json
  updatedAt  DateTime @updatedAt
}

// Stage 17: opt-in preferences ONLY. Conversation and documents stay in their source tables.
model CareerAgentMemory {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key           String   @db.VarChar(32)
  value         String   @db.VarChar(120)
  allowedAgents String[] @default([])
  revision      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId, updatedAt])
}
