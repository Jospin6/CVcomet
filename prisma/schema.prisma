// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                   String          @id @default(uuid())
  email                String          @unique
  name                 String?
  emailVerified        Boolean         @default(false)
  verificationCode     String?
  image                String?
  phone                String?
  address              String?
  languages            String?
  linkedin             String?
  portfolio            String?
  github               String?
  summary              String?
  password             String?
  skills               String?
  hobbies              String?
  headline             String?
  careerGoal           String?
  experienceLevel      String?
  targetJobTitle       String?
  targetIndustry       String?
  targetCountry        String?
  preferredWorkMode    String?
  resumeSource         String?
  targetMarket         String?
  referralSource       String?
  templateAccent       String?         @default("#173F35")
  coverLetterAccent    String?         @default("#173F35")
  onboardingCompletedAt DateTime?
  profileRevision      Int             @default(0)
  awards               Json?
  professionalLinks    Json?
  portfolioSlug        String?         @unique
  portfolioPublic      Boolean         @default(false)
  isSubscribed         Boolean         @default(false)
  role                 UserRole        @default(USER)
  lastGeneratedAt      DateTime?
  subscriptionId       String?
  generationCount      Int             @default(0)
  currentTemplateId    String?
  currentTemplate      Template?       @relation("UserCurrentTemplate", fields: [currentTemplateId], references: [id])
  currentCoverLetterId String?
  stripeCustomerId     String?
  currentCoverLetter   Template?       @relation("UserCurrentCoverLetter", fields: [currentCoverLetterId], references: [id])
  certifications       Certification[]
  Education            Education[]
  Experience           Experience[]
  Project              Project[]
  Conversation         Conversation[]
  atsAnalyses          AtsAnalysis[]
  jobOpportunities     JobOpportunity[]
  jobMatches           JobMatch[]
  jobApplications      JobApplication[]
  interviewSessions    InterviewSession[]
  aiUsage              AIUsage[]
  uploadedResumes      UploadedResume[]
  careerMaps           CareerMap[]
  careerGoals          CareerGoal[]
  subscription         Subscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  Account Account[]

  Session Session[]
}

model CareerMap {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvId        String?
  title       String
  preferences Json
  profile     Json
  graph       Json
  careerGoals CareerGoal[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId, updatedAt])
}

model CareerGoal {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerMapId String?
  careerMap   CareerMap? @relation(fields: [careerMapId], references: [id], onDelete: SetNull)
  roleId      String
  title       String
  plan        Json
  completedStepIds String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId, updatedAt])
  @@unique([userId, roleId])
}

enum UserRole {
  USER
  ADMIN
}

model Account {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Champs communs
  type       String?
  providerId String
  accountId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Pour credentials
  password String?

  // Pour OAuth
  providerAccountId String?
  refresh_token     String?
  access_token      String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([providerId, accountId])
}

model Session {
  id           String   @id @default(uuid())
  token        String?   @unique @map("sessionToken")
  userId       String
  expires      DateTime?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ipAddress    String?
  userAgent    String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String?
  value      String?
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Conversation {
  id        String   @id @default(uuid())
  title     String?
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  CoverLetter CoverLetter[]
  Cv          Cv[]
  Message     Message[]
}

model Experience {
  id          String  @id @default(uuid())
  title       String
  company     String
  location    String
  start       String
  end         String?
  description String?
  userId      String
  user        User    @relation(fields: [userId], references: [id])
}

model Education {
  id          String  @id @default(uuid())
  degree      String
  school      String
  start       String
  end         String?
  description String?
  userId      String
  user        User    @relation(fields: [userId], references: [id])
}

model Certification {
  id           String  @id @default(uuid())
  name         String
  organization String
  date         String
  description  String?
  userId       String
  user         User    @relation(fields: [userId], references: [id])
}

model Project {
  id          String  @id @default(uuid())
  start       String?
  end         String?
  title       String
  url         String?
  description String?
  userId      String
  user        User    @relation(fields: [userId], references: [id])
}

model Cv {
  id             String   @id @default(uuid())
  title          String
  summary        String[]
  skills         Json?
  experiences    Json?
  educations     Json?
  certifications Json?
  projects       Json?
  languages      Json?
  contact        Json?
  design         Json?
  revision       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  templateId     String?
  template       Template?    @relation(fields: [templateId], references: [id])
  versions       ResumeVersion[]
  atsAnalyses    AtsAnalysis[]
  jobMatches     JobMatch[]
  tailoredMatches JobMatch[] @relation("TailoredResume")
  applications  JobApplication[]
  coverLetters  CoverLetter[]
}

model UploadedResume {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  mimeType    String
  size        Int
  content     Bytes
  previewText String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model CoverLetter {
  id             String  @id @default(uuid())
  recipientName  String
  recipientTitle String
  companyName    String?
  companyAddress String?
  positionTitle  String?

  introduction String
  body         String
  conclusion   String?

  senderName    String?
  senderAddress String?
  senderEmail   String?
  senderPhone   String?
  sendertitle   String?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  templateId     String?
  template       Template?    @relation(fields: [templateId], references: [id])
  jobId          String?
  job            JobOpportunity? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  cvId           String?
  cv             Cv?             @relation(fields: [cvId], references: [id], onDelete: SetNull)
  design         Json?
  revision       Int             @default(0)
  applications   JobApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cvId, createdAt])
}

model Template {
  id           String       @id @default(uuid())
  name         String
  plan         Plan         @default(FREE)
  type         TemplateType // 'CV' ou 'COVER_LETTER'
  templateFile Bytes? // chemin du fichier HTML ou PDF ou JSON
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  markets      String[]     @default([])
  styleFamily  String       @default("MODERN")
  customizable Boolean      @default(true)
  accentColors String[]     @default(["#173F35", "#1E4B8F", "#6B4F3A", "#111827"])

  usersUsingAsTemplate    User[]        @relation("UserCurrentTemplate")
  usersUsingAsCoverLetter User[]        @relation("UserCurrentCoverLetter")
  CVs                     Cv[]
  CoverLetters            CoverLetter[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String // 'user' | 'assistant'
  content        String
  createdAt      DateTime     @default(now())
}

enum TemplateType {
  CV
  COVER_LETTER
}

enum Plan {
  FREE
  PAID
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW
  TECHNICAL_INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum InterviewType {
  HR
  BEHAVIORAL
  TECHNICAL
  LEADERSHIP
}

enum SubscriptionPlan {
  FREE
  PRO
  CAREER_PRO
}

enum SubscriptionStatus {
  INACTIVE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model ResumeVersion {
  id        String   @id @default(uuid())
  cvId      String
  cv        Cv       @relation(fields: [cvId], references: [id], onDelete: Cascade)
  label     String?
  snapshot  Json
  createdAt DateTime @default(now())
  @@index([cvId, createdAt])
}

model AtsAnalysis {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvId            String?
  cv              Cv?      @relation(fields: [cvId], references: [id], onDelete: SetNull)
  overallScore    Int
  structureScore  Int
  formattingScore Int
  readabilityScore Int
  contactScore    Int
  experienceScore Int
  skillsScore     Int
  keywordScore    Int
  impactScore     Int
  grammarScore    Int
  strengths       Json
  issues          Json
  createdAt       DateTime @default(now())
  @@index([userId, createdAt])
  @@index([cvId])
}

model JobOpportunity {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  company         String?
  location        String?
  seniority       String?
  description     String
  responsibilities Json?
  requiredSkills  Json?
  preferredSkills Json?
  technologies    Json?
  education       Json?
  experience      Json?
  keywords        Json?
  sourceUrl       String?
  sourceType      String   @default("URL")
  sourceName      String?
  originalText    String?
  analysis        Json?
  documentDrafts  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  matches         JobMatch[]
  applications    JobApplication[]
  coverLetters    CoverLetter[]
  @@index([userId, createdAt])
}

model JobMatch {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId           String
  job             JobOpportunity @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cvId            String?
  cv              Cv?      @relation(fields: [cvId], references: [id], onDelete: SetNull)
  overallScore    Int?
  skillScore      Int?
  keywordScore    Int?
  experienceScore Int?
  educationScore  Int?
  fingerprint     String?  @unique
  result          Json?
  tailoring       Json?
  tailoredCvId    String?
  tailoredCv      Cv? @relation("TailoredResume", fields: [tailoredCvId], references: [id], onDelete: SetNull)
  matchedSkills   Json
  missingSkills   Json
  unverifiedSkills Json
  recommendations Json
  createdAt       DateTime @default(now())
  @@index([userId, createdAt])
  @@index([jobId])
}

model JobApplication {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId         String?
  job           JobOpportunity? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  cvId          String?
  cv            Cv?      @relation(fields: [cvId], references: [id], onDelete: SetNull)
  coverLetterId String?
  coverLetter   CoverLetter? @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)
  company       String
  jobTitle      String
  location      String?
  country       String?
  workMode      String?
  contractType  String?
  salary        String?
  currency      String?
  jobUrl        String?
  source        String?
  status        ApplicationStatus @default(SAVED)
  appliedAt     DateTime?
  deadline      DateTime?
  notes         String?
  contactPerson String?
  nextAction    String?
  interviewAt   DateTime?
  archivedAt    DateTime?
  cvSnapshot    Json?
  coverLetterSnapshot Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  interviews    InterviewSession[]
  statusEvents  ApplicationStatusEvent[]
  reminders     ApplicationReminder[]
  @@index([userId, status])
  @@index([userId, createdAt])
}

model ApplicationStatusEvent {
  id            String   @id @default(uuid())
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        ApplicationStatus
  note          String?
  createdAt     DateTime @default(now())
  @@index([applicationId, createdAt])
}

model ApplicationReminder {
  id            String   @id @default(uuid())
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  dueAt         DateTime
  note          String?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  @@index([applicationId, dueAt])
}

model InterviewSession {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  type          InterviewType
  title         String
  overallScore  Int?
  summary       String?
  scheduledAt   DateTime?
  timezone      String?
  format        String?
  contactPerson String?
  preparationNotes String?
  outcome       String?
  status        String   @default("ACTIVE")
  configuration Json?
  report        Json?
  currentQuestion Int    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  messages      InterviewMessage[]
  @@index([userId, createdAt])
}

model InterviewMessage {
  id        String   @id @default(uuid())
  sessionId String
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  feedback  Json?
  score     Int?
  createdAt DateTime @default(now())
  @@index([sessionId, createdAt])
}

model AIUsage {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature       String
  model         String?
  provider      String?
  inputTokens   Int?
  outputTokens  Int?
  estimatedCost Decimal? @db.Decimal(12, 6)
  createdAt     DateTime @default(now())
  @@index([userId, feature, createdAt])
}

enum AIProvider {
  OPENAI
  GOOGLE
  ANTHROPIC
  HUGGINGFACE
  GROQ
}

model AISettings {
  id             String     @id @default("global")
  activeProvider AIProvider @default(GOOGLE)
  updatedBy      String?
  updatedAt      DateTime   @updatedAt
}

model AIProviderConfig {
  provider          AIProvider @id
  model             String
  encryptedApiKey   String?
  useEnvironmentKey Boolean    @default(true)
  enabled           Boolean    @default(true)
  updatedBy         String?
  updatedAt         DateTime   @updatedAt
}

model JobBoard {
  id             String   @id @default(uuid())
  provider       String
  region         String   @default("GLOBAL")
  slug           String
  companyName    String?
  careerUrl      String
  discoverySource String
  status         String   @default("PENDING")
  activeJobs     Int      @default(0)
  failureCount   Int      @default(0)
  lastError      String?
  discoveredAt   DateTime @default(now())
  verifiedAt     DateTime?
  lastSyncedAt   DateTime?
  nextCheckAt    DateTime @default(now())
  jobs           ExternalJob[]
  @@unique([provider, region, slug])
  @@index([status, nextCheckAt])
}

model ExternalJob {
  id          String   @id @default(uuid())
  boardId     String
  board       JobBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  provider    String
  externalId  String
  title       String
  company     String
  description String
  location    String?
  contractType String?
  sourceUrl   String
  applyUrl    String
  publishedAt DateTime?
  active      Boolean  @default(true)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  @@unique([provider, externalId])
  @@index([active, lastSeenAt])
  @@index([boardId, active])
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan @default(FREE)
  status               SubscriptionStatus @default(INACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?  @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
