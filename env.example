# Copier ce fichier vers .env et remplacer les valeurs d'exemple.

# Base de données PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:change_me@localhost:5432/cvcomet?schema=public"

# Authentification : remplacer par un secret aléatoire long et unique.
JWT_SECRET="replace_with_a_long_random_secret"

# Intelligence artificielle
OPENAI_API_KEY="replace_with_your_openai_api_key"
GOOGLE_GENERATIVE_MODEL_API_KEY="replace_with_your_google_gemini_api_key"
# Shared model for extraction, rewriting, resumes and cover letters.
GEMINI_MODEL="gemini-3.5-flash"

# Stripe : clés privées côté serveur (exemples en mode test)
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# Stripe : valeurs publiques exposées au navigateur
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
# Identifiant du tarif récurrent utilisé pour l'abonnement.
NEXT_PUBLIC_PRICE_ID="price_replace_me"

# Mode d'exécution : défini automatiquement par Next.js selon la commande.
# Valeurs possibles : development, production, test.
# NODE_ENV="development"
