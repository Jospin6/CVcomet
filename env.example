# Copier ce fichier vers .env et remplacer les valeurs d'exemple.

# Base de données PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:change_me@localhost:5432/cvcomet?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:change_me@localhost:5432/cvcomet?schema=public"

# Authentification Better Auth : secret aleatoire long et unique.
BETTER_AUTH_SECRET="replace_with_a_long_random_secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Compatibilite avec la configuration precedente si BETTER_AUTH_SECRET est absent.
JWT_SECRET="replace_with_a_long_random_secret"

# Connexion Google (facultative)
# GOOGLE_CLIENT_ID="replace_with_your_google_client_id"
# GOOGLE_CLIENT_SECRET="replace_with_your_google_client_secret"

# Envoi des codes de verification email (facultatif)
# RESEND_API_KEY="re_replace_me"
# RESEND_FROM_EMAIL="CVcomet <no-reply@example.com>"

# Intelligence artificielle : les réglages admin ont priorité sur ces valeurs.
# Conservez ce secret stable et sauvegardez-le pour déchiffrer les clés enregistrées.
AI_CONFIG_ENCRYPTION_KEY="replace_with_a_long_random_secret"
# Initial provider, before any selection is saved in the admin area.
AI_PROVIDER="GOOGLE"
# Optional bootstrap keys/models; keys can also be managed entirely in /admin/ai.
# OPENAI_API_KEY="your_openai_key"
# OPENAI_MODEL="gpt-4o-mini"
# GOOGLE_GENERATIVE_MODEL_API_KEY="your_gemini_key"
# GEMINI_MODEL="gemini-3.5-flash"
# ANTHROPIC_API_KEY="your_anthropic_key"
# ANTHROPIC_MODEL="select_a_model_in_admin"
# HUGGINGFACE_API_KEY="your_hf_inference_token"
# HUGGINGFACE_MODEL="select_a_model_in_admin"
# GROQ_API_KEY="your_groq_key"
# GROQ_MODEL="select_a_model_in_admin"

# Stripe : clés privées côté serveur (exemples en mode test)
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# Stripe : valeurs publiques exposées au navigateur
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
# Identifiant du tarif récurrent utilisé pour l'abonnement.
NEXT_PUBLIC_PRICE_ID="price_replace_me"

# Mode d'exécution : défini automatiquement par Next.js selon la commande.
# Valeurs possibles : development, production, test.
# NODE_ENV="development"

# Extraction des offres chargees en JavaScript : Chrome/Edge est detecte localement.
# Sur un serveur Linux : npm run setup:job-browser
# Chemin facultatif vers un autre executable Chromium installe sur le serveur.
# JOB_BROWSER_EXECUTABLE_PATH="/usr/bin/chromium"
## Optional, comma-separated public boards verified by the operator.
## Leave empty to keep these providers disabled.
GREENHOUSE_JOB_BOARDS=
LEVER_JOB_SITES=
## Secret used by the bounded scheduled board synchronization endpoint.
JOB_BOARD_SYNC_SECRET=
